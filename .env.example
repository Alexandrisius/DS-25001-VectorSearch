# =============================================================================
# KSR Vector Search v2 - Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ---------- General ----------
ENV=production
LOG_LEVEL=INFO
# json|text. В production рекомендуется json — легче фильтровать в `make logs-api | jq`
LOG_FORMAT=text
CORS_ORIGINS=*
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ---------- PostgreSQL ----------
POSTGRES_DB=ksr
POSTGRES_USER=ksr
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://ksr:change-me-strong-password@postgres:5432/ksr
SYNC_DATABASE_URL=postgresql://ksr:change-me-strong-password@postgres:5432/ksr

# ---------- Qdrant ----------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ---------- Redis (Celery broker + cache) ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- Security ----------
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
# Default dev password: "admin" (НЕ используйте в проде!)
ADMIN_PASSWORD_HASH=$2b$12$pf0rRxh0DY4vUNGqcADyi.jAAUsv83FRM/oOV.I4AGjUVPeyabQm6
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-random-32-chars-minimum
JWT_EXPIRE_HOURS=8
JWT_ALGORITHM=HS256
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---------- Login rate-limit ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# ---------- OpenRouter (default values, can be overridden via admin UI) ----------
OPENROUTER_API_KEY=
# Custom endpoint для OpenAI-совместимых серверов (LM Studio, Ollama, vLLM)
# Пусто = использовать OpenRouter (https://openrouter.ai/api/v1)
# Для LM Studio на этом же ПК: http://host.docker.internal:1234/v1
OPENROUTER_BASE_URL=
OPENROUTER_MODEL_EMBED=qwen/qwen3-embedding-4b
OPENROUTER_MODEL_RERANK=cohere/rerank-4-pro
OPENROUTER_BATCH_SIZE=10
OPENROUTER_MAX_WORKERS=3
OPENROUTER_REQUEST_TIMEOUT=60
OPENROUTER_MAX_RETRIES=3

# ---------- Cloudflare Tunnel ----------
# Создайте туннель в Cloudflare Dashboard → Zero Trust → Networks → Tunnels
# Скопируйте токен сюда — контейнер cloudflared поднимется автоматически.
# Оставьте пустым, если хотите работать только на localhost.
TUNNEL_TOKEN=

# ---------- Search defaults ----------
TOP_K_QDRANT=500
MAX_FOR_RERANK=100
MAX_RESULTS=100
DEFAULT_COSINE_THRESHOLD=0.45
DEFAULT_RERANK_THRESHOLD=0.6
EMBEDDING_CACHE_SIZE=15000

# ---------- BM25 (hybrid sparse retrieval) ----------
BM25_ENABLED=true
BM25_TOP_K=200
BM25_MAX_RETRIEVE=100
HYBRID_RERANK_LIMIT=200

# ---------- Import ----------
IMPORT_BATCH_SIZE_API=10
IMPORT_BATCH_SIZE_LOCAL=32
FOLDER_REBUILD_BATCH=100

# ---------- Telemetry ----------
SENTRY_DSN=
