# =============================================================================
# KSR Vector Search v2 - Production Environment Template
# Скопируйте в .env на сервере и заполните реальными значениями
# =============================================================================

# ---------- Server ----------
ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://ksrmatch.online,https://www.ksrmatch.online
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ---------- PostgreSQL ----------
# Сгенерируйте надёжный пароль: openssl rand -base64 32
POSTGRES_DB=ksr
POSTGRES_USER=ksr
POSTGRES_PASSWORD=СГЕНЕРИРОВАТЬ
DATABASE_URL=postgresql+asyncpg://ksr:СГЕНЕРИРОВАТЬ@postgres:5432/ksr
SYNC_DATABASE_URL=postgresql://ksr:СГЕНЕРИРОВАТЬ@postgres:5432/ksr

# ---------- Qdrant ----------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- Security (ОБЯЗАТЕЛЬНО замените!) ----------
# 1. ADMIN_PASSWORD_HASH — bcrypt хеш вашего пароля
#    Генерация: python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASS', bcrypt.gensalt(rounds=12)).decode())"
ADMIN_PASSWORD_HASH=

# 2. JWT_SECRET_KEY — случайный 32+ символов
#    Генерация: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# 3. ENCRYPTION_KEY — Fernet ключ для шифрования OpenRouter API ключа
#    Генерация: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

JWT_EXPIRE_HOURS=8
JWT_ALGORITHM=HS256

# ---------- Rate-limit ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# ---------- OpenRouter ----------
# ОСТАВЬТЕ ПУСТЫМ — вставите через UI /admin после первого запуска
# ВАЖНО: используйте НОВЫЙ ключ, не утёкший из feature-qdrant!
OPENROUTER_API_KEY=
OPENROUTER_MODEL_EMBED=qwen/qwen3-embedding-4b
OPENROUTER_MODEL_RERANK=qwen/qwen3-rerank-8b
OPENROUTER_BATCH_SIZE=10
OPENROUTER_MAX_WORKERS=3
OPENROUTER_REQUEST_TIMEOUT=60
OPENROUTER_MAX_RETRIES=3

# ---------- Search defaults ----------
TOP_K_QDRANT=500
MAX_FOR_RERANK=100
MAX_RESULTS=100
DEFAULT_COSINE_THRESHOLD=0.45
DEFAULT_RERANK_THRESHOLD=0.6
EMBEDDING_CACHE_SIZE=15000

# ---------- BM25 hybrid ----------
BM25_ENABLED=true
BM25_TOP_K=200
BM25_MAX_RETRIEVE=100
HYBRID_RERANK_LIMIT=200

# ---------- Import ----------
IMPORT_BATCH_SIZE_API=10
IMPORT_BATCH_SIZE_LOCAL=32
FOLDER_REBUILD_BATCH=100

# ---------- Telemetry (optional) ----------
# SENTRY_DSN=https://xxxx@sentry.io/123
SENTRY_DSN=

# ---------- Cloudflare Tunnel (опционально, только если используете) ----------
# TUNNEL_TOKEN=eyJhIjoixxxxxxxx...
